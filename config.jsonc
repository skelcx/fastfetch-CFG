{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "/home/broski/.config/fastfetch/girl.png",
        "type": "kitty-direct",
        "width": 44,
        "height": 22,
        "padding": {
            "top": 1,
            "left": 2,
            "right": 6
        }
    },
    "display": {
        "separator": "  "
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": "\u001b[35m         「ようこそ、ご主人様」"
        },
        "break",
        "break",
        "break",
        "break",
        {
            "type": "title",
            "format": "\u001b[35m             {1}@{2}\u001b[0m",
            "color": {
                "user": "35",
                "at": "90",
                "host": "35"
            }
        },
                {
            "type": "os",
            "key": " ",
            "keyColor": "33",  // = color3
        },
        {
            "type": "kernel",
            "key": " ",
            "keyColor": "33",
        },
        {
            "type": "packages",
            "format": "{} (pacman)",
            "key": " ",
            "keyColor": "33",  
        },
        {
            "type": "shell",
            "key": " ",
            "keyColor": "33", 
        },
        {
            "type": "terminal",
            "key": " ",
            "keyColor": "33", 
        },
        {
            "type": "wm",
            "key": " ",
            "keyColor": "33", 
        },
        {
            "type": "uptime",
            "key": " ",
            "keyColor": "33", 
        },
        {
            "type": "media",
            "key": "󰝚 ",
            "keyColor": "33", 
        },

        "break",
        "break",
        "break",
        "break",
        {
            "type": "custom",
            "format": "\u001b[35m              「夢を見る」"
        },
        "break"
    ]
}
